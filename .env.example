# ── Polymarket Bot — main .env example ───────────────────────────────────────
# Copy to .env and fill in. Never commit the real file.
# Every var here maps 1:1 to a field in src/polybot/config.py.

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=120
MIN_LIQUIDITY_USD=500
MIN_EDGE_THRESHOLD=0.08

# ── Simulated trading (paper mode) ───────────────────────────────────────────
SIMULATED_STARTING_BALANCE=1000.0
SIMULATED_MAX_POSITION_USD=10.0
MAX_OPEN_POSITIONS=10

# ── Cheap-tail size boost ────────────────────────────────────────────────────
# At entry price ≤ CHEAP_TAIL_THRESHOLD the per-position cap is multiplied by
# CHEAP_TAIL_SIZE_MULTIPLIER. Set multiplier=1.0 to disable.
CHEAP_TAIL_THRESHOLD=0.20
CHEAP_TAIL_SIZE_MULTIPLIER=2.5

# ── Live execution (Polymarket global / CLOB) ────────────────────────────────
LIVE_TRADING=false
WALLET_PRIVATE_KEY=
POLY_PROXY_ADDRESS=
MAX_DAILY_LOSS_USD=50.0
LIVE_MAX_POSITION_USD=50.0

# CLOB API credentials (order placement)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ── Web dashboard ────────────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8765

# ── Telegram alerts (optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0

# ── Crypto bot ───────────────────────────────────────────────────────────────
CRYPTO_ENABLED=false
CRYPTO_MIN_EDGE=0.10

# ── Polymarket US (sports bot) ───────────────────────────────────────────────
# polymarket.us/developer — separate from CLOB keys.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
SPORTS_ENABLED=false
SPORTS_SCAN_INTERVAL_SECONDS=30
SPORTS_MIN_EDGE=0.05
SPORTS_MAX_DAILY_LOSS=50.0
SPORTS_LEAGUES=NBA,MLB,EPL,UCL,MLS,FIFA
# Hard kill-switch: true = alert only, never place live US orders.
SPORTS_ALERT_ONLY=true
# Flat $ size per sports opp (overrides Kelly). 0 = use Kelly.
SPORTS_FLAT_SIZE_USD=20.0

# ── Vault integration (Obsidian sports KB, optional) ─────────────────────────
VAULT_PATH=
VAULT_CACHE_SECONDS=600

# ── Live in-game sports trading ──────────────────────────────────────────────
LIVE_SPORTS_ENABLED=false
LIVE_SPORTS_MIN_EDGE=0.08
LIVE_SPORTS_MIN_SECONDS_REMAINING=120
LIVE_SPORTS_BLOWOUT_MARGIN=0.85
LIVE_SPORTS_KELLY_FRACTION=0.15
LIVE_SPORTS_MAX_POSITION_USD=8.0
ESPN_LIVE_POLL_INTERVAL=30

# ── The Odds API (Layer 2 sports confirmation, free tier 500 req/month) ──────
ODDS_API_KEY=

# ── Delay Arbitrage ──────────────────────────────────────────────────────────
DELAY_ARB_ENABLED=false
DELAY_ARB_COOLDOWN_MINUTES=30.0

# ── Paths ────────────────────────────────────────────────────────────────────
TRADE_LOG_PATH=data/trades/trades.jsonl
LOG_FILE_PATH=data/trades/bot.log
WEATHER_LOG_PATH=data/trades/weather.log
SPORTS_LOG_PATH=data/trades/sports.log

# ── Service mode ─────────────────────────────────────────────────────────────
HEADLESS=false

# ── Dashboard service ────────────────────────────────────────────────────────
SCANNER_WS_URL=ws://localhost:8765/ws
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8766

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── LLM opportunity picker (optional) ────────────────────────────────────────
# OpenAI-compatible endpoint. Together/Fireworks/vLLM/llama.cpp all work.
LLM_PICKER_ENABLED=false
LLM_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=writer/palmyra-fin-70b-32k
LLM_API_KEY=
